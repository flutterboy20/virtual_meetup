# Production environment for the relay server.
#
# Copy to `.env` beside the compose file and fill in. `.env` is gitignored;
# this file is committed and must never hold a real value.
#
#   cp deploy/.env.example deploy/.env
#
# Every variable here has a default in `server/lib/src/config.dart`, and a
# value that is present but unparseable throws at startup rather than being
# silently ignored. A server that will not boot is a better failure than one
# that boots wrong.

# ---------------------------------------------------------------------------
# The two that decide whether the event happens at all
# ---------------------------------------------------------------------------

# TODO(domain): not decided yet. Whatever the final hostname is, it goes here
# AND in the client's --dart-define=SERVER_URL below, and the two must agree
# exactly. Candidates so far: fluttercon2026 / virtual-meetup / …
#
# Unset or blank means an EMPTY SET, which refuses every browser at the
# WebSocket handshake. That is deliberate — forgetting this fails loudly in
# seconds rather than leaving the door open for the length of the event — but
# it does mean a deploy that skips this line serves a site nobody can join.
#
# Scheme + host, lowercase, no trailing slash, no path. Comma-separated for
# more than one. `*` means any origin and is the development value only.
ALLOWED_ORIGINS=https://CHANGE-ME.duckdns.org

# The same hostname WITHOUT the scheme. Caddy reads this through
# docker-compose.yml and issues the certificate for it, so a typo here is a
# certificate for the wrong name rather than a quiet misconfiguration.
# TODO(domain): must match the host part of ALLOWED_ORIGINS exactly.
SITE_DOMAIN=CHANGE-ME.duckdns.org

# Enables moderation. Absent means moderation is OFF, not open: the hub
# refuses every message on every admin socket. Minimum 16 characters; shorter
# throws at startup.
#
# Generate with:  openssl rand -base64 32
# Lives only on the VM. Never in git, never in a screenshot, never in a
# --dart-define, never in a log line.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------

# Container-internal only. Caddy reaches this over the compose network; it is
# never published to the host. Default 8080.
PORT=8080

# Dart's default old-generation heap is 30GB, which is the absence of a limit
# rather than a limit. --abort_on_oom matters: without it the isolate throws
# and the process limps on in a state nothing tests; with it the process dies
# and Docker's restart policy brings it back.
#
# **COMMA-SEPARATED, NOT SPACES.** Measured on Dart 3.13.0: a space-separated
# value is parsed as ONE flag and the whole thing is discarded with
#
#   Ignoring flag: 512 --abort_on_oom is an invalid value for old_gen_heap_size
#
# — a single line that scrolls past in a startup banner, leaving the process
# running with no ceiling at all. Verified live: with a comma the flag takes
# effect (a deliberately tiny heap aborts the process on boot); with a space
# it does not.
#
# The container's mem_limit in docker-compose.yml is 768m, deliberately ABOVE
# this 512: the heap is not the whole process, and if Docker's limit were the
# lower of the two it would OOM-kill the container before this ever fired.
DART_VM_OPTIONS=--old_gen_heap_size=512,--abort_on_oom

# ---------------------------------------------------------------------------
# State — must land on a mounted volume
# ---------------------------------------------------------------------------
#
# On an ephemeral filesystem these vanish on every redeploy, which quietly
# turns every ban into a kick and loses the moderator's live config edits.

# The event's editable copy, served at GET /config. Read from disk at startup,
# so a config pushed last night is what the first arrival this morning gets.
CONFIG_FILE=/data/config.json

# The ban list. A file rather than a database because at this scale it is a
# few dozen strings, and during an incident you want to read it — and empty
# it — with the tools already on the box.
BAN_FILE=/data/bans.json

# Append-only record of every admin action.
AUDIT_FILE=/data/audit.log

# ---------------------------------------------------------------------------
# Capacity — backstops, not tuning. Neither should ever fire on the day.
# ---------------------------------------------------------------------------

# Hard cap, checked at the HTTP upgrade before a socket is allocated. The only
# refusal cheap enough to survive the flood it exists for. 503 at the upgrade.
MAX_SOCKETS=800

# Soft cap, the one a person meets: a join past it is refused with
# `worldFull`, which costs a socket precisely so the client can say why.
MAX_PLAYERS=400

# ---------------------------------------------------------------------------
# Event-day levers — restart to apply, not a rebuild
# ---------------------------------------------------------------------------
#
# Written out at today's defaults on purpose, so that at 09:30 on the day you
# edit a number instead of remembering one. Phase 7 measured the emergency
# settings as TICK_HZ=10 and NEIGHBOUR_CAP=24; see RESULTS.md.

# Snapshot rate. Multiplies straight into outbound messages, outbound bytes
# and server CPU. Default is 66ms, which is 15.2Hz.
TICK_HZ=15

# The most neighbours one snapshot may carry. The second knob Phase 7 swept.
NEIGHBOUR_CAP=40

# Interest grid cell edge, in world units. Too small and players pop in at the
# edge of the screen; too large and everybody is everybody's neighbour and the
# culling buys nothing.
CELL_SIZE=320

# How long a dropped socket keeps its seat. A hall with solid wifi wants this
# short so seats free promptly; a basement with dead spots wants it long so a
# two-minute outage is not a kick. 0 means hold nothing.
SESSION_LINGER_SECONDS=90

# How long a kicked session is refused. Too short and the client's own
# reconnect walks the person straight back in; too long and a warning shot has
# become a ban nobody recorded.
KICK_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# Profiling — off in production
# ---------------------------------------------------------------------------
#
# Appends a row per reporting window. Off by default because a server that
# writes files nobody asked for is a server that fills a disk during a
# six-hour event. Set to a path under /data only while load testing.
# METRICS_CSV=/data/metrics.csv

# ---------------------------------------------------------------------------
# The client reads NONE of this
# ---------------------------------------------------------------------------
#
# Flutter web has no process environment. The client's endpoint is a
# COMPILE-TIME constant baked into the bundle at build time:
#
#   fvm flutter build web --release \
#     --dart-define=SERVER_URL=wss://CHANGE-ME.duckdns.org/ws
#
# TODO(domain): same hostname as ALLOWED_ORIGINS above, wss:// not https://,
# and the /ws path is required. /config, /metrics and the admin socket are all
# derived from it — see client/lib/core/server_endpoint.dart — so this is the
# one knob, and changing the domain later means a full client rebuild.
#
# Forgetting the flag builds successfully and ships a bundle that dials
# ws://localhost:8080/ws forever — there is no error, no warning, and the app
# looks fine until nobody can join. Verified: a bundle built without the flag
# contains the string exactly once. So check before uploading, every time:
#
#   grep -c "localhost:8080" client/build/web/main.dart.js   # must be 0
#
# --dart-define=PERF_HUD=true compiles in an on-screen fps/p95/jank readout.
# Never in a production build; it is tree-shaken out when absent.
