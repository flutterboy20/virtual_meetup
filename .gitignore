# ─────────────────────────────────────────────────────────────
#  PROCESS / PLANNING — never pushed to GitHub.
#  (Claude Code still READS these locally; .gitignore only
#   controls what gets committed, not what Claude Code can see.)
#
#  This root file owns the ignores for the whole workspace —
#  the packages deliberately have no .gitignore of their own.
# ─────────────────────────────────────────────────────────────
/.planning/
CLAUDE.md
*.kt.md
*.session.md
/scratch/
NOTES.md

# ─────────────────────────────────────────────────────────────
#  fvm — the pin (.fvmrc) IS committed, the downloaded SDK is not.
# ─────────────────────────────────────────────────────────────
.fvm/

# ─────────────────────────────────────────────────────────────
#  Dart / Flutter build artifacts
#
#  pubspec.lock IS committed: this repo ships a deployed app and
#  server, so CI and prod must resolve the exact same versions.
#  Pub workspaces mean there is only the one lockfile, at the root.
# ─────────────────────────────────────────────────────────────
.dart_tool/
.packages
build/
/client/build/
/coverage/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.widget_preview/
**/doc/api/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# ─────────────────────────────────────────────────────────────
#  Editors / OS
# ─────────────────────────────────────────────────────────────
*.iml
*.ipr
*.iws
.idea/
.vscode/
*.log
*.swp
.history
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
#  Secrets — NEVER commit
# ─────────────────────────────────────────────────────────────
.env
*.env
secrets/
*.pem

# Signing material and key stores. None of these has ever been in this repo;
# the rules exist so that the first one to appear is refused by git rather
# than caught by a reviewer.
*.key
*.p12
*.pfx
*.jks
*.keystore

# ─────────────────────────────────────────────────────────────
#  State written by the running server
# ─────────────────────────────────────────────────────────────
# The ban list and the audit trail are runtime state about real attendees,
# not source. They are per-deployment and must never be committed.
bans.json
audit.log

# The event's live config belongs here for the same reason, and was missed
# until Phase 13. `ConfigStore` writes this file every time a moderator edits
# anything, so a tracked copy means a 09:00 edit dirties the working tree of
# whatever checkout production is running from — and the copy in git is
# somebody's local dev state rather than the event's. `config.example.json`
# is committed instead; a server with no config file at all starts on the
# built-in defaults.
config.json

# Production deploy: filled-in secrets, runtime state, uploaded bundle.
# deploy/.env.example, Dockerfile, Caddyfile and docker-compose.yml ARE committed.
deploy/.env
deploy/data/
deploy/web/

# --- Pre-push hardening -----------------------------------------------------
# Added before the repo went public. Each line is a file that would otherwise
# have been swept in by `git add .`.

# EVERY .env variant, not just a bare `.env`. The rules above match `.env` and
# anything ENDING in `.env`, which misses `.env.local` and `.env.production` —
# exactly the two names a real secret ends up in.
.env.*
# ...except the committed templates, which hold no values.
!.env.example
!deploy/.env.example

# Compiled server binaries. `dart compile exe` drops one beside the source,
# and a 7MB binary in a diff is nobody's idea of a reviewable change.
*.exe
server/relay

# What the profiler writes when METRICS_CSV is set. Load-test output is a
# local artefact, not a repository file.
*.csv

# Generated by pub/melos, and written inside the Docker image by
# deploy/Dockerfile. Never authored by hand, never committed.
pubspec_overrides.yaml

# Coverage output in ANY package. The rule above is anchored to the root, so
# it misses client/coverage/ — which is where flutter test --coverage writes.
coverage/

# Local backups of deploy/data taken with the tar line in deploy/README.md.
# These contain the ban list and the audit log.
*.tgz
*.tar.gz
